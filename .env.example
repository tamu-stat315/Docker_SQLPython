# Copy this file to .env only when you need different local ports, a different
# local-only Jupyter token, or a nondefault native-Linux user ID. Changing the
# database password requires `docker compose down --volumes` so PostgreSQL can
# initialize it again.
STAT315_STUDENT_PASSWORD=stat315_local_only
STAT315_JUPYTER_TOKEN=stat315
STAT315_HOST_UID=1000
JUPYTER_PORT=8888
PGADMIN_PORT=5050
